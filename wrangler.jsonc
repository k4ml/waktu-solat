{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "waktu-solat",
	"main": "src/entry.py",
	"compatibility_date": "2025-11-02",
	"compatibility_flags": [
		"python_workers"
	],
	"assets": {
		"directory": "./public"
	},
	"vars": {
		"SITE_ORIGIN": "https://solat.koditi.my"
	},
	"observability": {
		"enabled": true
	},
	"previews": {}
}
